#!/usr/bin/env bash
# Clipboard history picker (cliphist + wofi).
# Picking an entry copies it back to the clipboard.

entry=$(cliphist list | wofi --dmenu --prompt "Clipboard" --width 720 --lines 12) || exit 0
[[ -z $entry ]] && exit 0

tmp=$(mktemp)
printf '%s' "$entry" | cliphist decode > "$tmp" || { rm -f "$tmp"; exit 1; }
wl-copy < "$tmp"
rm -f "$tmp"
